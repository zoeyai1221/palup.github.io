---
import Button from '@components/ui/Button.astro';
---

<section
	data-testid="hero"
	class="flex min-h-[90vh] flex-col items-center justify-center gap-12 pb-12 pt-8 lg:flex-row lg:gap-20 lg:pb-20"
>
	<!-- Text column -->
	<div class="flex flex-col items-start lg:w-3/5">
		<p class="mb-3 text-xs font-bold uppercase tracking-widest text-orange">UX Case Study — 2026</p>
		<h1 class="mb-5 font-monospace text-6xl font-bold leading-none text-black dark:text-white lg:text-8xl">
			PalUp
		</h1>
		<p class="mb-3 text-xl font-medium text-black dark:text-white lg:text-2xl">
			Finding your next meal companion —<br />one conversation at a time.
		</p>
		<p class="mb-8 max-w-lg text-base leading-relaxed text-gray-500">
			A mobile app that connects people for shared dining experiences in a new city, built from
			research through high-fidelity prototype.
		</p>

		<div class="mb-10 grid grid-cols-2 gap-x-10 gap-y-4 text-sm">
			<div>
				<p class="mb-0.5 text-xs font-bold uppercase tracking-widest text-orange">Role</p>
				<p class="text-black dark:text-white">UX Researcher &amp; Interaction Designer</p>
			</div>
			<div>
				<p class="mb-0.5 text-xs font-bold uppercase tracking-widest text-orange">Timeline</p>
				<p class="text-black dark:text-white">January – April 2026</p>
			</div>
			<div>
				<p class="mb-0.5 text-xs font-bold uppercase tracking-widest text-orange">Team</p>
				<p class="text-black dark:text-white">Siyu Ai · Karena Ma · Suiyang Mai · Xinran Wang</p>
			</div>
			<div>
				<p class="mb-0.5 text-xs font-bold uppercase tracking-widest text-orange">Tools</p>
				<p class="text-black dark:text-white">Figma · Affinity Diagrams · Interviews</p>
			</div>
		</div>

		<a
			href="https://www.figma.com/proto/GHEjNtXC88rwqjANMyj82r/PalUp?node-id=628-2444&t=9MffpE68rPn1Mh8K-1"
			target="_blank"
			rel="noopener"
		>
			<Button style={'primary'} size={'lg'} name="View Prototype">View Interactive Prototype →</Button>
		</a>
	</div>

	<!-- Phone mockup column -->
	<div class="flex items-center justify-center lg:w-2/5">
		<figure class="relative">
			<img
				src="/images/palup/high_fi_homescreen.png"
				alt="PalUp high-fidelity homescreen"
				class="w-[220px] rounded-[2.5rem] shadow-2xl ring-1 ring-black/10 dark:ring-white/10 lg:w-[260px]"
				loading="eager"
			/>
		</figure>
	</div>
</section>
