---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const imgMods = import.meta.glob<{ default: ImageMetadata }>(
	'../assets/images/palup/*.{png,jpg,jpeg}',
	{ eager: true }
);
const img = (name: string): ImageMetadata =>
	(imgMods[`../assets/images/palup/${name}`] as { default: ImageMetadata }).default;
---

<section data-testid="process" id="process" class="py-10 lg:py-14">

	<div class="sticky top-16 z-40 bg-white/95 pb-5 backdrop-blur-sm dark:bg-black/95">
		<p class="mb-2 inline-block rounded-md bg-orange/10 px-3 py-1 font-monospace text-base font-bold text-orange lg:text-lg">03 — Design Process</p>
		<h2 class="font-monospace text-3xl text-black dark:text-white lg:text-5xl">Four iterative phases</h2>
	</div>
	<p class="mb-8 max-w-xl text-sm leading-loose text-gray-600 dark:text-gray-400">
		Each phase built directly on what we learned. Every design decision traced back to a specific
		finding from research or evaluation.
	</p>

	<!-- Process timeline — fidelity curve -->
	<div id="fidelity-chart" class="mb-10">
		<svg viewBox="0 0 560 230" class="w-full" aria-hidden="true">
			<!-- Y axis -->
			<line x1="36" y1="10" x2="36" y2="168" stroke="#d1d5db" stroke-width="1"/>
			<polygon points="36,6 32,14 40,14" fill="#d1d5db"/>
			<!-- X axis -->
			<line x1="36" y1="168" x2="548" y2="168" stroke="#d1d5db" stroke-width="1"/>
			<polygon points="552,168 544,164 544,172" fill="#d1d5db"/>
			<!-- Axis labels -->
			<text x="42" y="13" font-size="8" fill="#9ca3af" font-family="ui-monospace,monospace" letter-spacing="1">FIDELITY</text>
			<text x="510" y="184" font-size="8" fill="#9ca3af" font-family="ui-monospace,monospace" letter-spacing="1">TIME</text>

			<!-- Dashed drop lines -->
			<line class="drop drop-1" x1="90"  y1="110" x2="90"  y2="168" stroke="#f97316" stroke-width="1" stroke-dasharray="3,3"/>
			<line class="drop drop-2" x1="222" y1="96"  x2="222" y2="168" stroke="#f97316" stroke-width="1" stroke-dasharray="3,3"/>
			<line class="drop drop-3" x1="354" y1="60"  x2="354" y2="168" stroke="#f97316" stroke-width="1" stroke-dasharray="3,3"/>
			<line class="drop drop-4" x1="486" y1="22"  x2="486" y2="168" stroke="#f97316" stroke-width="1" stroke-dasharray="3,3"/>

			<!-- Bezier curve -->
			<path class="curve-line"
			      d="M 90,110 C 156,110 156,96 222,96 C 288,96 288,60 354,60 C 420,60 420,22 486,22"
			      fill="none" stroke="#f97316" stroke-width="2.5" stroke-linecap="round"/>

			<!-- Nodes -->
			<g class="node node-1"><circle cx="90"  cy="110" r="22" fill="#f97316"/><text x="90"  y="115" text-anchor="middle" font-size="11" font-weight="bold" fill="white" font-family="ui-monospace,monospace">01</text></g>
			<g class="node node-2"><circle cx="222" cy="96"  r="22" fill="#f97316"/><text x="222" y="101" text-anchor="middle" font-size="11" font-weight="bold" fill="white" font-family="ui-monospace,monospace">02</text></g>
			<g class="node node-3"><circle cx="354" cy="60"  r="22" fill="#f97316"/><text x="354" y="65"  text-anchor="middle" font-size="11" font-weight="bold" fill="white" font-family="ui-monospace,monospace">03</text></g>
			<g class="node node-4"><circle cx="486" cy="22"  r="22" fill="#f97316"/><text x="486" y="27"  text-anchor="middle" font-size="11" font-weight="bold" fill="white" font-family="ui-monospace,monospace">04</text></g>

			<!-- Phase labels (inside SVG, centered on node x) -->
			<g class="label label-1">
				<text x="90"  y="184" text-anchor="middle" font-size="8.5" font-weight="bold" font-family="ui-sans-serif,sans-serif" class="label-title">Paper Prototype</text>
				<text x="90"  y="195" text-anchor="middle" font-size="7.5" font-family="ui-sans-serif,sans-serif" fill="#9ca3af">12 issues found</text>
				<text x="90"  y="205" text-anchor="middle" font-size="7.5" font-family="ui-sans-serif,sans-serif" fill="#9ca3af">Feb 2026</text>
			</g>
			<g class="label label-2">
				<text x="222" y="184" text-anchor="middle" font-size="8.5" font-weight="bold" font-family="ui-sans-serif,sans-serif" class="label-title">Wireframes</text>
				<text x="222" y="195" text-anchor="middle" font-size="7.5" font-family="ui-sans-serif,sans-serif" fill="#9ca3af">Low fidelity</text>
				<text x="222" y="205" text-anchor="middle" font-size="7.5" font-family="ui-sans-serif,sans-serif" fill="#9ca3af">Feb 2026</text>
			</g>
			<g class="label label-3">
				<text x="354" y="184" text-anchor="middle" font-size="8.5" font-weight="bold" font-family="ui-sans-serif,sans-serif" class="label-title">Medium-Fi</text>
				<text x="354" y="195" text-anchor="middle" font-size="7.5" font-family="ui-sans-serif,sans-serif" fill="#9ca3af">User testing</text>
				<text x="354" y="205" text-anchor="middle" font-size="7.5" font-family="ui-sans-serif,sans-serif" fill="#9ca3af">Mar 2026</text>
			</g>
			<g class="label label-4">
				<text x="486" y="184" text-anchor="middle" font-size="8.5" font-weight="bold" font-family="ui-sans-serif,sans-serif" class="label-title">High-Fi</text>
				<text x="486" y="195" text-anchor="middle" font-size="7.5" font-family="ui-sans-serif,sans-serif" fill="#9ca3af">Final prototype</text>
				<text x="486" y="205" text-anchor="middle" font-size="7.5" font-family="ui-sans-serif,sans-serif" fill="#9ca3af">Apr 2026</text>
			</g>
		</svg>
	</div>

	<style>
		/* Curve draw-on */
		#fidelity-chart .curve-line {
			stroke-dasharray: 620;
			stroke-dashoffset: 620;
			transition: stroke-dashoffset 1s cubic-bezier(0.16, 1, 0.3, 1) 0.15s;
		}
		#fidelity-chart.in-view .curve-line { stroke-dashoffset: 0; }

		/* Drop lines */
		#fidelity-chart .drop { opacity: 0; transition: opacity 0.4s ease; }
		#fidelity-chart.in-view .drop-1 { opacity: 0.35; transition-delay: 0.75s; }
		#fidelity-chart.in-view .drop-2 { opacity: 0.35; transition-delay: 0.95s; }
		#fidelity-chart.in-view .drop-3 { opacity: 0.35; transition-delay: 1.15s; }
		#fidelity-chart.in-view .drop-4 { opacity: 0.35; transition-delay: 1.35s; }

		/* Node scale-in */
		#fidelity-chart .node {
			transform-box: fill-box;
			transform-origin: center;
			opacity: 0;
			transform: scale(0.2);
			transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1), transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
		}
		#fidelity-chart.in-view .node-1 { opacity: 1; transform: scale(1); transition-delay: 0.7s; }
		#fidelity-chart.in-view .node-2 { opacity: 1; transform: scale(1); transition-delay: 0.9s; }
		#fidelity-chart.in-view .node-3 { opacity: 1; transform: scale(1); transition-delay: 1.1s; }
		#fidelity-chart.in-view .node-4 { opacity: 1; transform: scale(1); transition-delay: 1.3s; }

		/* Label text color */
		#fidelity-chart .label-title { fill: #111827; }
		:global(.dark) #fidelity-chart .label-title { fill: #f3f4f6; }

		/* Labels fade in */
		#fidelity-chart .label { opacity: 0; transition: opacity 0.4s ease; }
		#fidelity-chart.in-view .label-1 { opacity: 1; transition-delay: 0.75s; }
		#fidelity-chart.in-view .label-2 { opacity: 1; transition-delay: 0.95s; }
		#fidelity-chart.in-view .label-3 { opacity: 1; transition-delay: 1.15s; }
		#fidelity-chart.in-view .label-4 { opacity: 1; transition-delay: 1.35s; }

		@media (prefers-reduced-motion: reduce) {
			#fidelity-chart .curve-line,
			#fidelity-chart .drop,
			#fidelity-chart .node,
			#fidelity-chart .label { transition: none !important; }
			#fidelity-chart.in-view .curve-line { stroke-dashoffset: 0; }
			#fidelity-chart.in-view .drop,
			#fidelity-chart.in-view .node,
			#fidelity-chart.in-view .label { opacity: 1; }
		}
	</style>

	<script>
		const chart = document.getElementById('fidelity-chart');
		if (chart) {
			const obs = new IntersectionObserver(
				([e]) => { if (e.isIntersecting) chart.classList.add('in-view'); else chart.classList.remove('in-view'); },
				{ threshold: 0.25 }
			);
			obs.observe(chart);
		}
	</script>

	<!-- ─── Phase 01 ─── -->
	<div class="mb-10">
		<div class="mb-6">
			<p class="mb-1 font-monospace text-lg font-bold text-orange lg:text-xl">Phase 01</p>
			<h3 class="font-monospace text-xl font-bold text-black dark:text-white lg:text-2xl">Paper Prototype</h3>
		</div>

		<div class="rounded-2xl bg-gray-50 p-6 dark:bg-gray-900 lg:p-10">
		<p class="mb-4 text-2xl font-bold text-black dark:text-white">12 <span class="text-base font-normal text-gray-500">issues found</span></p>
		<div class="mb-6 grid gap-6 lg:grid-cols-2 lg:gap-10">
			<!-- Left: task flows -->
			<div>
				<p class="mb-3 text-sm font-medium text-gray-700 dark:text-gray-300">We sketched 4 core task flows:</p>
				<div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-800">
					<p class="mb-2 text-xs font-bold uppercase tracking-widest text-orange">Task Flows</p>
					<ul class="space-y-2 text-xs text-gray-600 dark:text-gray-400">
						<li class="flex gap-2"><span class="flex-shrink-0 font-bold text-orange">→</span>Managing a profile</li>
						<li class="flex gap-2"><span class="flex-shrink-0 font-bold text-orange">→</span>Finding and joining an event</li>
						<li class="flex gap-2"><span class="flex-shrink-0 font-bold text-orange">→</span>Creating an event</li>
						<li class="flex gap-2"><span class="flex-shrink-0 font-bold text-orange">→</span>Chatting with participants</li>
					</ul>
				</div>
			</div>
			<!-- Right: critical issues -->
			<div>
				<p class="mb-3 text-sm font-medium text-gray-700 dark:text-gray-300">A cross-team heuristic evaluation surfaced 12 issues, three rated most severe:</p>
				<div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-800">
					<p class="mb-2 text-xs font-bold uppercase tracking-widest text-orange">Critical</p>
					<ul class="space-y-2 text-xs text-gray-600 dark:text-gray-400">
						<li class="flex gap-2"><span class="flex-shrink-0 font-bold text-orange">→</span>No send button visible in chat</li>
						<li class="flex gap-2"><span class="flex-shrink-0 font-bold text-orange">→</span>No way to leave a chatroom</li>
						<li class="flex gap-2"><span class="flex-shrink-0 font-bold text-orange">→</span>Event creation and home browsing shared the same screen</li>
					</ul>
				</div>
			</div>
		</div>

		<p class="mb-2 text-xs font-bold uppercase tracking-widest text-gray-400">Before heuristic evaluation</p>
		<div class="mb-6 flex justify-center">
			<div class="grid w-full max-w-lg grid-cols-3 gap-3">
				<figure class="flex flex-col gap-1">
					<Image src={img('paper_prototype_before_eval_create_event.jpg')} alt="Paper prototype before — Create Event" class="w-full rounded-lg object-cover shadow ring-1 ring-black/5" loading="lazy"  />
					<figcaption class="text-center text-xs text-gray-400">Create Event</figcaption>
				</figure>
				<figure class="flex flex-col gap-1">
					<Image src={img('paper_prototype_before_eval_view_event_chatroom.jpg')} alt="Paper prototype before — View Event & Chatroom" class="w-full rounded-lg object-cover shadow ring-1 ring-black/5" loading="lazy"  />
					<figcaption class="text-center text-xs text-gray-400">View Event &amp; Chatroom</figcaption>
				</figure>
				<figure class="flex flex-col gap-1">
					<Image src={img('paper_prototype_before_eval_profile.jpg')} alt="Paper prototype before — Profile" class="w-full rounded-lg object-cover shadow ring-1 ring-black/5" loading="lazy"  />
					<figcaption class="text-center text-xs text-gray-400">Profile</figcaption>
				</figure>
			</div>
		</div>

		<p class="mb-2 text-xs font-bold uppercase tracking-widest text-gray-400">After heuristic evaluation</p>
		<div class="grid grid-cols-3 gap-3 sm:grid-cols-6">
			<figure class="flex flex-col gap-1">
				<Image src={img('paper_prototype_after_eval_create_event.jpg')} alt="Paper prototype after — Create Event" class="w-full rounded-lg object-cover shadow ring-1 ring-black/5" loading="lazy"  />
				<figcaption class="text-center text-xs text-gray-400">Create Event</figcaption>
			</figure>
			<figure class="flex flex-col gap-1">
				<Image src={img('paper_prototype_after_eval_join_event_1.jpg')} alt="Paper prototype after — Join Event 1" class="w-full rounded-lg object-cover shadow ring-1 ring-black/5" loading="lazy"  />
				<figcaption class="text-center text-xs text-gray-400">Join Event (1)</figcaption>
			</figure>
			<figure class="flex flex-col gap-1">
				<Image src={img('paper_prototype_after_eval_join_event_2.jpg')} alt="Paper prototype after — Join Event 2" class="w-full rounded-lg object-cover shadow ring-1 ring-black/5" loading="lazy"  />
				<figcaption class="text-center text-xs text-gray-400">Join Event (2)</figcaption>
			</figure>
			<figure class="flex flex-col gap-1">
				<Image src={img('paper_prototype_after_eval_chatroom.png')} alt="Paper prototype after — Chatroom" class="w-full rounded-lg object-cover shadow ring-1 ring-black/5" loading="lazy"  />
				<figcaption class="text-center text-xs text-gray-400">Chatroom</figcaption>
			</figure>
			<figure class="flex flex-col gap-1">
				<Image src={img('paper_prototype_after_eval_profile.png')} alt="Paper prototype after — Profile" class="w-full rounded-lg object-cover shadow ring-1 ring-black/5" loading="lazy"  />
				<figcaption class="text-center text-xs text-gray-400">Profile</figcaption>
			</figure>
			<figure class="flex flex-col gap-1">
				<Image src={img('paper_prototype_after_eval_setting.png')} alt="Paper prototype after — Settings" class="w-full rounded-lg object-cover shadow ring-1 ring-black/5" loading="lazy"  />
				<figcaption class="text-center text-xs text-gray-400">Settings</figcaption>
			</figure>
		</div>
		</div>
	</div>

	<!-- ─── Phase 02 ─── -->
	<div class="mb-10">
		<div class="mb-6">
			<p class="mb-1 font-monospace text-lg font-bold text-orange lg:text-xl">Phase 02</p>
			<h3 class="font-monospace text-xl font-bold text-black dark:text-white lg:text-2xl">Wireframes — Low Fidelity</h3>
		</div>
		<div class="rounded-2xl bg-gray-50 p-6 dark:bg-gray-900 lg:p-10">

		<div class="mb-6 grid gap-6 lg:grid-cols-2 lg:gap-10">
			<div>
				<p class="mb-3 text-2xl font-bold text-black dark:text-white">12 <span class="text-base font-normal text-gray-500">fixes applied</span></p>
				<p class="text-sm leading-loose text-gray-600 dark:text-gray-400">
					Moved into Figma and connected all flows into an interactive prototype, applying every heuristic evaluation fix.
				</p>
			</div>
			<div class="rounded-xl border border-gray-200 bg-white p-4 shadow-sm dark:border-gray-700 dark:bg-gray-800">
				<p class="mb-2 text-xs font-bold uppercase tracking-widest text-orange">Changes</p>
				<ul class="space-y-1.5 text-xs text-gray-600 dark:text-gray-400">
					<li class="flex gap-2"><span class="flex-shrink-0 font-bold text-orange">→</span>Added floating "+" button as dedicated event creation trigger</li>
					<li class="flex gap-2"><span class="flex-shrink-0 font-bold text-orange">→</span>Added error states to the login flow</li>
					<li class="flex gap-2"><span class="flex-shrink-0 font-bold text-orange">→</span>Separated browsing and creating into distinct screens</li>
				</ul>
			</div>
		</div>

		<!-- 6 wireframe phones in one row -->
		<div class="mb-6 grid grid-cols-3 gap-3 sm:grid-cols-6">
			<figure class="flex flex-col items-center gap-1">
				<Image src={img('figma_wireframe_screenshot_home.png')} alt="Wireframe — Home" class="w-full rounded-xl shadow ring-1 ring-black/10" loading="lazy"  />
				<figcaption class="text-center text-xs text-gray-400">Home</figcaption>
			</figure>
			<figure class="flex flex-col items-center gap-1">
				<Image src={img('figma_wireframe_screenshot_create_event_preference.png')} alt="Wireframe — Create Event preferences" class="w-full rounded-xl shadow ring-1 ring-black/10" loading="lazy"  />
				<figcaption class="text-center text-xs text-gray-400">Preferences</figcaption>
			</figure>
			<figure class="flex flex-col items-center gap-1">
				<Image src={img('figma_wireframe_screenshot_create_event_preview.png')} alt="Wireframe — Create Event preview" class="w-full rounded-xl shadow ring-1 ring-black/10" loading="lazy"  />
				<figcaption class="text-center text-xs text-gray-400">Preview</figcaption>
			</figure>
			<figure class="flex flex-col items-center gap-1">
				<Image src={img('figma_wireframe_screenshot_create_event_posted.png')} alt="Wireframe — Event posted" class="w-full rounded-xl shadow ring-1 ring-black/10" loading="lazy"  />
				<figcaption class="text-center text-xs text-gray-400">Posted</figcaption>
			</figure>
			<figure class="flex flex-col items-center gap-1">
				<Image src={img('figma_wireframe_screenshot_chatroom.png')} alt="Wireframe — Chatroom" class="w-full rounded-xl shadow ring-1 ring-black/10" loading="lazy"  />
				<figcaption class="text-center text-xs text-gray-400">Chatroom</figcaption>
			</figure>
			<figure class="flex flex-col items-center gap-1">
				<Image src={img('figma_wireframe_screenshot_login_error.png')} alt="Wireframe — Login error" class="w-full rounded-xl shadow ring-1 ring-black/10" loading="lazy"  />
				<figcaption class="text-center text-xs text-gray-400">Login error</figcaption>
			</figure>
		</div>

		</div>
	</div>

	<!-- ─── Phase 03 ─── -->
	<div class="mb-10">
		<div class="mb-6">
			<p class="mb-1 font-monospace text-lg font-bold text-orange lg:text-xl">Phase 03</p>
			<h3 class="font-monospace text-xl font-bold text-black dark:text-white lg:text-2xl">Medium-Fidelity Prototype</h3>
		</div>

		<div class="rounded-2xl bg-gray-50 p-6 dark:bg-gray-900 lg:p-10">
		<div class="flex flex-col items-start gap-8 lg:flex-row lg:items-center lg:gap-12">
			<div data-animate="fade-left" class="lg:w-1/2">
				<div class="space-y-4">
					<div class="rounded-xl border border-gray-100 bg-white p-4 shadow-sm dark:border-gray-800 dark:bg-gray-900">
						<p class="mb-0.5 text-xs font-bold uppercase tracking-widest text-gray-400">Issue 1</p>
						<p class="mb-1 text-sm font-semibold text-black dark:text-white">Newly posted events weren't tappable on Home</p>
						<p class="text-xs text-gray-500">Users had to navigate to My Events to see their new event.</p>
						<p class="mt-1 text-xs font-medium text-orange">Fix: All event cards made tappable across every screen.</p>
					</div>
					<div class="rounded-xl border border-gray-100 bg-white p-4 shadow-sm dark:border-gray-800 dark:bg-gray-900">
						<p class="mb-0.5 text-xs font-bold uppercase tracking-widest text-gray-400">Issue 2</p>
						<p class="mb-1 text-sm font-semibold text-black dark:text-white">"Vibe" field label confused participants</p>
						<p class="text-xs text-gray-500">Options (Quiet / Casual / Deep) were too abstract to interpret.</p>
						<p class="mt-1 text-xs font-medium text-orange">Fix: Renamed to "Dining Atmosphere" with clearer options.</p>
					</div>
				</div>
			</div>

			<div class="flex justify-center gap-4 lg:w-1/2">
				<figure data-animate="fade-up" data-delay="0" class="flex flex-col items-center gap-1">
					<Image src={img('medium_fi_create_event_preferences.png')} alt="Medium-fi — Create Event preferences" class="w-[150px] rounded-2xl shadow-lg ring-1 ring-black/10 transition-transform duration-300 hover:scale-105 lg:w-[180px]" loading="lazy"  />
					<figcaption class="text-center text-xs text-gray-400">Create Event — preferences</figcaption>
				</figure>
				<figure data-animate="fade-up" data-delay="150" class="flex flex-col items-center gap-1">
					<Image src={img('medium_fi_tappable_card.png')} alt="Medium-fi — Tappable event card" class="w-[150px] rounded-2xl shadow-lg ring-1 ring-black/10 transition-transform duration-300 hover:scale-105 lg:w-[180px]" loading="lazy"  />
					<figcaption class="text-center text-xs text-gray-400">Tappable event card</figcaption>
				</figure>
			</div>
		</div>
		</div>
	</div>

	<!-- ─── Phase 04 ─── -->
	<div>
		<div class="mb-6">
			<p class="mb-1 font-monospace text-lg font-bold text-orange lg:text-xl">Phase 04</p>
			<h3 class="font-monospace text-xl font-bold text-black dark:text-white lg:text-2xl">High-Fidelity Prototype</h3>
		</div>
		<div class="rounded-2xl bg-gray-50 p-6 dark:bg-gray-900 lg:p-10">
		<p class="mb-1 text-sm leading-loose text-gray-600 dark:text-gray-400">A second round of testing and expert critique pushed the design further.</p>
		<p class="mb-6 text-2xl font-bold text-black dark:text-white">6 <span class="text-base font-normal text-gray-500">key changes</span></p>

		<!-- Changes table -->
		<div class="mb-8 overflow-x-auto rounded-xl border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-800">
			<table class="w-full text-xs">
				<thead>
					<tr class="border-b border-gray-200 dark:border-gray-700">
						<th class="px-4 py-3 text-left font-bold uppercase tracking-widest text-orange">Issue found</th>
						<th class="px-4 py-3 text-left font-bold uppercase tracking-widest text-orange">Fix applied</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-gray-100 dark:divide-gray-700">
					<tr>
						<td class="px-4 py-2.5 text-gray-600 dark:text-gray-400">"Budget" vs. total cost ambiguity</td>
						<td class="px-4 py-2.5 font-medium text-black dark:text-white">Renamed to Budget/Person</td>
					</tr>
					<tr>
