---

<section data-testid="evaluation" id="evaluation" class="py-10 lg:py-14">

	<div class="sticky top-16 z-40 bg-white/95 pb-5 backdrop-blur-sm dark:bg-black/95">
		<p class="mb-2 inline-block rounded-md bg-orange/10 px-3 py-1 font-monospace text-base font-bold text-orange lg:text-lg">04 — Evaluation</p>
		<h2 class="font-monospace text-3xl text-black dark:text-white lg:text-5xl">
			What we tested and what we found
		</h2>
	</div>

	<!-- Summary container -->
	<div class="mb-8 rounded-2xl bg-gray-50 p-6 dark:bg-gray-900 lg:p-8">
		<div class="flex flex-col gap-8 lg:flex-row lg:gap-10">

			<!-- Left: testing structure + task flows -->
			<div class="lg:flex-1">
				<p class="mb-3 text-xs font-bold uppercase tracking-widest text-gray-400">Testing structure</p>
				<div class="grid gap-3 sm:grid-cols-2">

					<!-- Round 1 -->
					<div data-animate="fade-up" data-delay="0" class="rounded-xl border border-gray-100 bg-white p-4 dark:border-gray-800 dark:bg-gray-800">
						<div class="mb-2 flex items-center gap-2">
							<div class="flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-orange text-[10px] font-bold text-white">1</div>
							<p class="text-xs font-bold text-black dark:text-white">Round 1</p>
						</div>
						<p class="mb-4 text-xs leading-relaxed text-gray-400">Wireframe prototype · Heuristic evaluation + Think-aloud</p>
						<div class="flex flex-wrap items-center gap-1 text-orange">
							<!-- 8 solid + 2 semi-transparent = 8–10 participants -->
							<svg viewBox="0 0 16 20" fill="currentColor" class="h-4 w-3.5"><circle cx="8" cy="5" r="4"/><path d="M0 19c0-4.418 3.582-8 8-8s8 3.582 8 8"/></svg>
							<svg viewBox="0 0 16 20" fill="currentColor" class="h-4 w-3.5"><circle cx="8" cy="5" r="4"/><path d="M0 19c0-4.418 3.582-8 8-8s8 3.582 8 8"/></svg>
							<svg viewBox="0 0 16 20" fill="currentColor" class="h-4 w-3.5"><circle cx="8" cy="5" r="4"/><path d="M0 19c0-4.418 3.582-8 8-8s8 3.582 8 8"/></svg>
							<svg viewBox="0 0 16 20" fill="currentColor" class="h-4 w-3.5"><circle cx="8" cy="5" r="4"/><path d="M0 19c0-4.418 3.582-8 8-8s8 3.582 8 8"/></svg>
							<svg viewBox="0 0 16 20" fill="currentColor" class="h-4 w-3.5"><circle cx="8" cy="5" r="4"/><path d="M0 19c0-4.418 3.582-8 8-8s8 3.582 8 8"/></svg>
							<svg viewBox="0 0 16 20" fill="currentColor" class="h-4 w-3.5"><circle cx="8" cy="5" r="4"/><path d="M0 19c0-4.418 3.582-8 8-8s8 3.582 8 8"/></svg>
							<svg viewBox="0 0 16 20" fill="currentColor" class="h-4 w-3.5"><circle cx="8" cy="5" r="4"/><path d="M0 19c0-4.418 3.582-8 8-8s8 3.582 8 8"/></svg>
							<svg viewBox="0 0 16 20" fill="currentColor" class="h-4 w-3.5"><circle cx="8" cy="5" r="4"/><path d="M0 19c0-4.418 3.582-8 8-8s8 3.582 8 8"/></svg>
							<svg viewBox="0 0 16 20" fill="currentColor" class="h-4 w-3.5 opacity-40"><circle cx="8" cy="5" r="4"/><path d="M0 19c0-4.418 3.582-8 8-8s8 3.582 8 8"/></svg>
							<svg viewBox="0 0 16 20" fill="currentColor" class="h-4 w-3.5 opacity-40"><circle cx="8" cy="5" r="4"/><path d="M0 19c0-4.418 3.582-8 8-8s8 3.582 8 8"/></svg>
							<span class="ml-1 text-xs text-gray-400">8–10 participants</span>
						</div>
					</div>

					<!-- Round 2 -->
					<div data-animate="fade-up" data-delay="120" class="rounded-xl border border-gray-100 bg-white p-4 dark:border-gray-800 dark:bg-gray-800">
						<div class="mb-2 flex items-center gap-2">
							<div class="flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-orange text-[10px] font-bold text-white">2</div>
							<p class="text-xs font-bold text-black dark:text-white">Round 2</p>
						</div>
						<p class="mb-4 text-xs leading-relaxed text-gray-400">High-fidelity prototype · Heuristic evaluation + Think-aloud</p>
						<div class="flex flex-wrap items-center gap-1 text-orange">
							<!-- 8 solid + 2 semi-transparent = 8–10 participants -->
							<svg viewBox="0 0 16 20" fill="currentColor" class="h-4 w-3.5"><circle cx="8" cy="5" r="4"/><path d="M0 19c0-4.418 3.582-8 8-8s8 3.582 8 8"/></svg>
							<svg viewBox="0 0 16 20" fill="currentColor" class="h-4 w-3.5"><circle cx="8" cy="5" r="4"/><path d="M0 19c0-4.418 3.582-8 8-8s8 3.582 8 8"/></svg>
							<svg viewBox="0 0 16 20" fill="currentColor" class="h-4 w-3.5"><circle cx="8" cy="5" r="4"/><path d="M0 19c0-4.418 3.582-8 8-8s8 3.582 8 8"/></svg>
							<svg viewBox="0 0 16 20" fill="currentColor" class="h-4 w-3.5"><circle cx="8" cy="5" r="4"/><path d="M0 19c0-4.418 3.582-8 8-8s8 3.582 8 8"/></svg>
							<svg viewBox="0 0 16 20" fill="currentColor" class="h-4 w-3.5"><circle cx="8" cy="5" r="4"/><path d="M0 19c0-4.418 3.582-8 8-8s8 3.582 8 8"/></svg>
							<svg viewBox="0 0 16 20" fill="currentColor" class="h-4 w-3.5"><circle cx="8" cy="5" r="4"/><path d="M0 19c0-4.418 3.582-8 8-8s8 3.582 8 8"/></svg>
							<svg viewBox="0 0 16 20" fill="currentColor" class="h-4 w-3.5"><circle cx="8" cy="5" r="4"/><path d="M0 19c0-4.418 3.582-8 8-8s8 3.582 8 8"/></svg>
							<svg viewBox="0 0 16 20" fill="currentColor" class="h-4 w-3.5"><circle cx="8" cy="5" r="4"/><path d="M0 19c0-4.418 3.582-8 8-8s8 3.582 8 8"/></svg>
							<svg viewBox="0 0 16 20" fill="currentColor" class="h-4 w-3.5 opacity-40"><circle cx="8" cy="5" r="4"/><path d="M0 19c0-4.418 3.582-8 8-8s8 3.582 8 8"/></svg>
							<svg viewBox="0 0 16 20" fill="currentColor" class="h-4 w-3.5 opacity-40"><circle cx="8" cy="5" r="4"/><path d="M0 19c0-4.418 3.582-8 8-8s8 3.582 8 8"/></svg>
							<span class="ml-1 text-xs text-gray-400">8–10 participants</span>
						</div>
					</div>

				</div>

				<!-- Task flows -->
				<div class="mt-5">
					<p class="mb-3 text-xs font-bold uppercase tracking-widest text-gray-400">4 task flows evaluated</p>
					<div class="grid grid-cols-2 gap-3 lg:grid-cols-4">
						<div data-animate="fade-up" data-delay="0" class="flex flex-col items-center justify-center rounded-[50%] border border-gray-100 bg-white py-10 px-4 text-center dark:border-gray-800 dark:bg-gray-900">
							<span class="mb-2 font-monospace text-sm font-bold text-orange">01</span>
							<!-- gear / settings -->
							<svg viewBox="0 0 20 20" fill="currentColor" class="mb-2 h-6 w-6 text-orange"><path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 0 1-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 0 1 .947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 0 1 2.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 0 1 2.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 0 1 .947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 0 1-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 0 1-2.287-.947zM10 13a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" clip-rule="evenodd"/></svg>
							<span class="text-xs font-semibold leading-snug text-gray-800 dark:text-gray-200">Log in &amp; manage profile</span>
						</div>
						<div data-animate="fade-up" data-delay="80" class="flex flex-col items-center justify-center rounded-[50%] border border-gray-100 bg-white py-10 px-4 text-center dark:border-gray-800 dark:bg-gray-900">
							<span class="mb-2 font-monospace text-sm font-bold text-orange">02</span>
							<!-- fork & knife -->
							<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="mb-2 h-6 w-6 text-orange"><path d="M6 2v4m0 0v11m0-11a3 3 0 0 0 3-3"/><path d="M9 2v3a3 3 0 0 1-3 3"/><path d="M14 2c1.5 0 2.5 1.5 2.5 3.5V17"/><line x1="14" y1="2" x2="14" y2="17"/></svg>
							<span class="text-xs font-semibold leading-snug text-gray-800 dark:text-gray-200">Find and join a dining event</span>
						</div>
						<div data-animate="fade-up" data-delay="160" class="flex flex-col items-center justify-center rounded-[50%] border border-gray-100 bg-white py-10 px-4 text-center dark:border-gray-800 dark:bg-gray-900">
							<span class="mb-2 font-monospace text-sm font-bold text-orange">03</span>
							<!-- calendar + plus -->
							<svg viewBox="0 0 20 20" fill="currentColor" class="mb-2 h-6 w-6 text-orange"><rect x="2" y="4" width="16" height="14" rx="2"/><path d="M2 8h16" stroke="white" stroke-width="1.5"/><path d="M7 2v3M13 2v3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/><path d="M10 11v4M8 13h4" stroke="white" stroke-width="1.5" stroke-linecap="round"/></svg>
							<span class="text-xs font-semibold leading-snug text-gray-800 dark:text-gray-200">Create a dining event</span>
						</div>
						<div data-animate="fade-up" data-delay="240" class="flex flex-col items-center justify-center rounded-[50%] border border-gray-100 bg-white py-10 px-4 text-center dark:border-gray-800 dark:bg-gray-900">
							<span class="mb-2 font-monospace text-sm font-bold text-orange">04</span>
							<!-- chat bubble -->
							<svg viewBox="0 0 20 20" fill="currentColor" class="mb-2 h-6 w-6 text-orange"><path d="M18 10c0 4.418-3.582 8-8 8a8.1 8.1 0 0 1-3.5-.79L2 19l1.79-4.5A7.96 7.96 0 0 1 2 10c0-4.418 3.582-8 8-8s8 3.582 8 8z"/></svg>
							<span class="text-xs font-semibold leading-snug text-gray-800 dark:text-gray-200">Communicate in a chatroom</span>
						</div>
					</div>
				</div>
			</div>

			<!-- Right: outcomes -->
			<div class="shrink-0 lg:w-52">
				<p class="mb-3 text-xs font-bold uppercase tracking-widest text-gray-400">What we found</p>
				<p class="mb-5">
					<span class="font-monospace text-4xl font-bold text-orange">16</span>
					<span class="ml-1.5 text-xs text-gray-500">total issues surfaced</span>
				</p>
				<div class="flex flex-col gap-2">
					<div data-animate="fade-up" data-delay="0" class="rounded-lg bg-orange/10 px-3 py-2">
						<p class="text-xs font-semibold text-orange">Label clarity</p>
						<p class="text-xs leading-relaxed text-gray-500">small wording changes had outsized impact</p>
					</div>
					<div data-animate="fade-up" data-delay="80" class="rounded-lg bg-orange/10 px-3 py-2">
						<p class="text-xs font-semibold text-orange">Navigation consistency</p>
						<p class="text-xs leading-relaxed text-gray-500">users expected consistent actions across screens</p>
					</div>
					<div data-animate="fade-up" data-delay="160" class="rounded-lg bg-orange/10 px-3 py-2">
						<p class="text-xs font-semibold text-orange">Safety features</p>
						<p class="text-xs leading-relaxed text-gray-500">report flow and profile previews were expected</p>
					</div>
				</div>
			</div>

		</div>

		</div>
	</div>

	<!-- Round 1 -->
	<div class="mb-10">
		<div class="mb-4 flex items-center gap-3">
			<div class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-orange text-xs font-bold text-white">1</div>
			<div>
				<p class="text-xs font-bold uppercase tracking-widest text-orange">Round 1</p>
				<h3 class="font-monospace text-lg font-bold text-black dark:text-white">Heuristic Evaluation + User Testing</h3>
			</div>
		</div>
		<p class="mb-4 text-xs leading-relaxed text-gray-500">
			Evaluated on the wireframe / medium-fidelity prototype using Nielsen's heuristics.
		</p>
		<div class="flex flex-col divide-y divide-gray-100 rounded-xl border border-gray-100 bg-white dark:divide-gray-800 dark:border-gray-800 dark:bg-gray-900">
			<div class="hidden grid-cols-2 gap-6 border-b border-gray-100 px-4 py-2.5 dark:border-gray-800 lg:grid">
				<p class="text-xs font-bold uppercase tracking-widest text-orange">Task &amp; Issue</p>
				<p class="text-xs font-bold uppercase tracking-widest text-orange">Fix</p>
			</div>
			<div data-animate="fade-up" data-delay="0" class="grid gap-3 p-4 lg:grid-cols-2 lg:gap-6">
				<div>
					<p class="mb-1.5 text-xs font-bold uppercase tracking-widest text-gray-400">Create an event</p>
					<p class="text-xs leading-relaxed text-gray-600 dark:text-gray-400">Event card on Home tab was not tappable after creating — users had to navigate to My Events.</p>
				</div>
				<p class="text-xs leading-relaxed text-orange">→ All event cards made tappable, linking to the event detail page from any screen.</p>
			</div>
			<div data-animate="fade-up" data-delay="60" class="grid gap-3 p-4 lg:grid-cols-2 lg:gap-6">
				<div>
					<p class="mb-1.5 text-xs font-bold uppercase tracking-widest text-gray-400">Create an event</p>
					<p class="text-xs leading-relaxed text-gray-600 dark:text-gray-400">"Vibe" label and options (Quiet / Casual / Deep) too abstract to understand quickly.</p>
				</div>
				<p class="text-xs leading-relaxed text-orange">→ Renamed to "Dining Atmosphere"; options: Quiet Meal / Casual Hangout / Deep Conversation.</p>
			</div>
			<div data-animate="fade-up" data-delay="120" class="grid gap-3 p-4 lg:grid-cols-2 lg:gap-6">
				<div>
					<p class="mb-1.5 text-xs font-bold uppercase tracking-widest text-gray-400">Find and join an event</p>
					<p class="text-xs leading-relaxed text-gray-600 dark:text-gray-400">Participant avatars looked clickable but did nothing — users expected profile info on tap.</p>
				</div>
				<p class="text-xs leading-relaxed text-orange">→ Avatars now open participant profile details on tap.</p>
			</div>
			<div data-animate="fade-up" data-delay="180" class="grid gap-3 p-4 lg:grid-cols-2 lg:gap-6">
				<div>
					<p class="mb-1.5 text-xs font-bold uppercase tracking-widest text-gray-400">Find and join an event</p>
					<p class="text-xs leading-relaxed text-gray-600 dark:text-gray-400">Keyboard did not appear automatically when tapping the search bar.</p>
				</div>
				<p class="text-xs leading-relaxed text-orange">→ Keyboard now appears immediately on search bar tap.</p>
			</div>
			<div data-animate="fade-up" data-delay="240" class="grid gap-3 p-4 lg:grid-cols-2 lg:gap-6">
				<div>
					<p class="mb-1.5 text-xs font-bold uppercase tracking-widest text-gray-400">Communicate in chatroom</p>
					<p class="text-xs leading-relaxed text-gray-600 dark:text-gray-400">Toggling "Mute Notifications" had no visible change — users couldn't tell if it worked.</p>
				</div>
				<p class="text-xs leading-relaxed text-orange">→ Added pinned notice showing key event info at top of chatroom.</p>
			</div>
			<div data-animate="fade-up" data-delay="300" class="grid gap-3 p-4 lg:grid-cols-2 lg:gap-6">
				<div>
					<p class="mb-1.5 text-xs font-bold uppercase tracking-widest text-gray-400">Login &amp; manage profile</p>
					<p class="text-xs leading-relaxed text-gray-600 dark:text-gray-400">Error message on failed login not visually prominent — easy to overlook.</p>
				</div>
				<p class="text-xs leading-relaxed text-orange">→ Redesigned with stronger contrast and clearer placement.</p>
			</div>
		</div>
	</div>

	<!-- Round 2 -->
	<div class="mb-8">
		<div class="mb-4 flex items-center gap-3">
			<div class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-orange text-xs font-bold text-white">2</div>
			<div>
				<p class="text-xs font-bold uppercase tracking-widest text-orange">Round 2</p>
				<h3 class="font-monospace text-lg font-bold text-black dark:text-white">Heuristic Evaluation + User Testing</h3>
			</div>
		</div>
		<p class="mb-4 text-xs leading-relaxed text-gray-500">
			Evaluated on the high-fidelity prototype. Heuristic evaluation surfaced structural issues; think-aloud sessions with 4–5 new participants followed.
		</p>

		<p class="mb-3 text-xs font-bold uppercase tracking-widest text-gray-400">Heuristic Evaluation</p>
		<div class="mb-8 flex flex-col divide-y divide-gray-100 rounded-xl border border-gray-100 bg-white dark:divide-gray-800 dark:border-gray-800 dark:bg-gray-900">
			<div class="hidden grid-cols-2 gap-6 border-b border-gray-100 px-4 py-2.5 dark:border-gray-800 lg:grid">
				<p class="text-xs font-bold uppercase tracking-widest text-orange">Task &amp; Issue</p>
				<p class="text-xs font-bold uppercase tracking-widest text-orange">Fix</p>
			</div>
			<div data-animate="fade-up" data-delay="0" class="grid gap-3 p-4 lg:grid-cols-2 lg:gap-6">
				<div>
					<p class="mb-1.5 text-xs font-bold uppercase tracking-widest text-gray-400">Cancel and Edit Event</p>
					<p class="text-xs leading-relaxed text-gray-600 dark:text-gray-400">Users entering from Home had no way to cancel or edit — had to go to My Events.</p>
				</div>
				<p class="text-xs leading-relaxed text-orange">→ Cancel and Edit buttons added to event detail page regardless of entry point.</p>
			</div>
			<div data-animate="fade-up" data-delay="60" class="grid gap-3 p-4 lg:grid-cols-2 lg:gap-6">
				<div>
					<p class="mb-1.5 text-xs font-bold uppercase tracking-widest text-gray-400">View Event details</p>
					<p class="text-xs leading-relaxed text-gray-600 dark:text-gray-400">Only a small "›" button was tappable — conflicts with the proximity principle.</p>
				</div>
				<p class="text-xs leading-relaxed text-orange">→ Entire event card is now the tappable area.</p>
			</div>
			<div data-animate="fade-up" data-delay="120" class="grid gap-3 p-4 lg:grid-cols-2 lg:gap-6">
				<div>
					<p class="mb-1.5 text-xs font-bold uppercase tracking-widest text-gray-400">Chatroom — send message</p>
					<p class="text-xs leading-relaxed text-gray-600 dark:text-gray-400">Chat input field positioned beneath keyboard, deviating from standard mobile patterns.</p>
				</div>
				<p class="text-xs leading-relaxed text-orange">→ Input field repositioned directly above keyboard.</p>
			</div>
			<div data-animate="fade-up" data-delay="180" class="grid gap-3 p-4 lg:grid-cols-2 lg:gap-6">
				<div>
					<p class="mb-1.5 text-xs font-bold uppercase tracking-widest text-gray-400">Chatroom — edge case</p>
					<p class="text-xs leading-relaxed text-gray-600 dark:text-gray-400">No empty state design for a newly created chatroom with no messages or participants yet.</p>
				</div>
				<p class="text-xs leading-relaxed text-orange">→ Added empty chatroom state for post-creation scenarios.</p>
			</div>
			<div data-animate="fade-up" data-delay="240" class="grid gap-3 p-4 lg:grid-cols-2 lg:gap-6">
				<div>
					<p class="mb-1.5 text-xs font-bold uppercase tracking-widest text-gray-400">Login &amp; manage profile</p>
					<p class="text-xs leading-relaxed text-gray-600 dark:text-gray-400">Login &amp; Security screen had no entry point for help or support.</p>
				</div>
				<p class="text-xs leading-relaxed text-orange">→ Added Help &amp; Support button on the Login &amp; Security page.</p>
			</div>
		</div>

		<p class="mb-3 text-xs font-bold uppercase tracking-widest text-gray-400">User Testing</p>
		<div class="flex flex-col divide-y divide-gray-100 rounded-xl border border-gray-100 bg-white dark:divide-gray-800 dark:border-gray-800 dark:bg-gray-900">
			<div class="hidden grid-cols-2 gap-6 border-b border-gray-100 px-4 py-2.5 dark:border-gray-800 lg:grid">
				<p class="text-xs font-bold uppercase tracking-widest text-orange">Task &amp; Issue</p>
				<p class="text-xs font-bold uppercase tracking-widest text-orange">Fix</p>
			</div>
			<div data-animate="fade-up" data-delay="0" class="grid gap-3 p-4 lg:grid-cols-2 lg:gap-6">
				<div>
					<p class="mb-1.5 text-xs font-bold uppercase tracking-widest text-gray-400">Create Event — preferences</p>
					<p class="text-xs leading-relaxed text-gray-600 dark:text-gray-400">"Budget" ambiguous (total vs. per-person?). "Group Size" unclear if creator was counted.</p>
				</div>
				<p class="text-xs leading-relaxed text-orange">→ Renamed to "Budget/Person"; added "incl. yourself" hint to Group Size.</p>
			</div>
			<div data-animate="fade-up" data-delay="60" class="grid gap-3 p-4 lg:grid-cols-2 lg:gap-6">
				<div>
					<p class="mb-1.5 text-xs font-bold uppercase tracking-widest text-gray-400">Chatroom — report user</p>
					<p class="text-xs leading-relaxed text-gray-600 dark:text-gray-400">Once a report reason was selected, users couldn't modify it without restarting the flow.</p>
				</div>
				<p class="text-xs leading-relaxed text-orange">→ Users can now change selected reason before submission.</p>
			</div>
			<div data-animate="fade-up" data-delay="120" class="grid gap-3 p-4 lg:grid-cols-2 lg:gap-6">
				<div>
					<p class="mb-1.5 text-xs font-bold uppercase tracking-widest text-gray-400">Chatroom — view user</p>
					<p class="text-xs leading-relaxed text-gray-600 dark:text-gray-400">Could tap others' avatars but not "You" to view own profile — had to navigate away.</p>
				</div>
				<p class="text-xs leading-relaxed text-orange">→ Tapping "You" now opens own profile preview from within the chatroom.</p>
