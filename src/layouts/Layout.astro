---
import Footer from '@components/Footer.astro';
import Navbar from '@components/Navbar.astro';
import { SEO } from 'astro-seo';

export interface LayoutProps {
	title: string;
}

const { title = 'PalUp | UX Case Study' } = Astro.props as LayoutProps;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth" data-testid="html">
	<head>
		<SEO
			title="PalUp — UX Case Study"
			description="A UX case study for PalUp, a mobile app connecting people for shared dining experiences in a new city."
		/>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta http-equiv="X-UA-Compatible" content="IE=edge" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body class="bg-white font-sans text-white dark:bg-black xs:text-[16px] md:text-[18px]">
		<Navbar />
		<div class="mx-auto max-w-screen-xl px-5">
			<slot />
			<Footer />
		</div>
		<style is:global>
			img {
				content-visibility: auto;
			}
		</style>
	</body>
</html>
